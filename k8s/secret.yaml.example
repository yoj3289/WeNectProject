apiVersion: v1
kind: Secret
metadata:
  name: wenect-secret
  namespace: wenect
type: Opaque
stringData:
  # Database credentials
  DB_USERNAME: "root"
  DB_PASSWORD: "YOUR_DB_PASSWORD_HERE"

  # JWT Secret (실제 배포 시 강력한 비밀키로 변경)
  JWT_SECRET: "YOUR_JWT_SECRET_HERE_AT_LEAST_256_BITS"

  # MySQL Root Password
  MYSQL_ROOT_PASSWORD: "YOUR_MYSQL_ROOT_PASSWORD_HERE"
  MYSQL_DATABASE: "mydb"
  MYSQL_USER: "root"
  MYSQL_PASSWORD: "YOUR_MYSQL_PASSWORD_HERE"

---
# 사용 방법:
# 1. 이 파일을 secret.yaml로 복사하세요:
#    cp secret.yaml.example secret.yaml
#
# 2. secret.yaml 파일에서 YOUR_*_HERE 부분을 실제 값으로 변경하세요
#
# 3. secret.yaml은 .gitignore에 포함되어 있으므로 Git에 커밋되지 않습니다
#
# 또는 kubectl 명령어로 직접 생성:
# kubectl create secret generic wenect-secret \
#   --from-literal=DB_PASSWORD=your-password \
#   --from-literal=JWT_SECRET=your-jwt-secret \
#   --from-literal=MYSQL_ROOT_PASSWORD=your-mysql-password \
#   -n wenect
